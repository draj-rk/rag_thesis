function pc = multicast_common_pre(H, P, Pt, t)
    % H: M x K channel matrix (M antennas, K users)
    % P: M x K precoding matrix (each column is a precoder for user k)
    
    h1 = H(:,1);
    h2 = H(:,2);
    
    beta1_sq = 0;
    beta2_sq = 0;
    
    P = sqrt(Pt*(1 - t) / 2)*P;
    
    for r = 1:2
        beta1_sq = beta1_sq + abs(h1' * P(:,r))^2;
        beta2_sq = beta2_sq + abs(h2' * P(:,r))^2;
    end
    
    beta1_sq = beta1_sq + 1;
    beta2_sq = beta2_sq + 1;
    
    h1_tilde = h1 / sqrt(beta1_sq);
    h2_tilde = h2 / sqrt(beta2_sq);
    
    H_tilde = [h1_tilde h2_tilde];
    
    G = H_tilde' * H_tilde;
    
    a11 = real(G(1,1));
    a22 = real(G(2,2));
    a12 = G(1,2);
    
    abs_a12 = abs(a12);
    denom = a11 + a22 - 2*abs_a12;
    lambda = (a11 * a22 - abs_a12^2) / denom;
    
    mu_vec = (1/denom) * [a22 - abs_a11; a11 - abs_a12];
    
    a12_
    
    
    
    
    pc = 0;
end